# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-preview/
# Production build used for performance measurement (.claude/launch.json:
# "spa-prod"). Same reason NEXT_DIST_DIR exists: a second build must not share
# a folder with the dev server's.
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local image backups (see scripts/optimize-images.py)
/backup/
