# SendGrid Configuration
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
CONTACT_TO_EMAIL=your-email@yourdomain.com
BUSINESS_NAME=Your Business Name

# Cloudflare Turnstile Configuration
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Supabase (Blog CMS) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SECRET, server-only. Never expose to the client.

# Google Reviews (homepage rating card + testimonial slider)
# 1. Google Cloud console → enable "Places API (New)" → create an API key (server-only, no
#    HTTP referrer restriction — the call is made from the server during build/revalidate).
# 2. Fill GOOGLE_PLACES_API_KEY below, then find the place id once:
#    node scripts/find-google-place-id.mjs "Spa Bali Moon Seminyak"
# Leave both blank and the site falls back to the static 5-star card and testimonials.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Absolute site URL, used for the AggregateRating JSON-LD on the homepage
NEXT_PUBLIC_SITE_URL=https://spabalimoon.com

# Admin blog login
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=random-string-at-least-32-characters-long
